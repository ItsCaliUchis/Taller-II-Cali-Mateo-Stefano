          "clean"
        ],
        "parallel_group": "embeddings",
        "default_args": [
          "--download-model"
        ]
      }
    },
    "bert": {
      "entrypoint": "preprocessing.bert:main",
      "description": "Modulo de procesamiento de embeddings Bert",
      "status": "active",
      "include": "preprocessing",
      "supports_help": true,
      "schedule": {
        "outputs": [
          "data/bert_vect.npz",
          "data/bert_vocab.csv"
